{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "unit": {
            "enum": [
              "milliseconds",
              "bytes",
              "per-second",
              "count",
              "percent"
            ]
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "variant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "routeTemplate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "event": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "stage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "statusClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "worker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": []
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 256
          },
          "buckets": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 257
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sum": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "censored": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "unit",
          "labels",
          "boundaries",
          "buckets",
          "count",
          "sum",
          "censored",
          "failed"
        ]
      },
      "maxItems": 100000
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "availability": {
            "const": "UNAVAILABLE"
          },
          "value": {
            "type": "null"
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "required": [
          "name",
          "availability",
          "value",
          "reasonCode"
        ]
      },
      "maxItems": 256
    },
    "observations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "series",
    "unavailable",
    "observations"
  ]
}
