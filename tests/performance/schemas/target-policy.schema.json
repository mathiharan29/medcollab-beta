{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocle:performance:schemas/target-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productionHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "trustedKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "publicKeyPem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "publicKeyPem"
        ]
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "topologyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "ownerIdentity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "budgetCeilings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persistentConnections": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "newConnectionsPerSecond": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "httpStartsPerSecond": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "messageStartsPerSecond": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "eventStartsPerSecond": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outboundDeliveries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "concurrentUploads": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxUploadBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytesTransferred": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalRequests": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalMessages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalEvents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "databaseGrowthBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "providerCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "elapsedMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "generatorMemoryBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sutMemoryBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "diskReserveBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "cpuPercent": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              },
              "costCeiling": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "currency": {
                "const": "USD"
              }
            },
            "required": [
              "persistentConnections",
              "newConnectionsPerSecond",
              "httpStartsPerSecond",
              "messageStartsPerSecond",
              "eventStartsPerSecond",
              "outboundDeliveries",
              "concurrentUploads",
              "maxUploadBytes",
              "bytesTransferred",
              "totalRequests",
              "totalMessages",
              "totalEvents",
              "databaseGrowthBytes",
              "providerCalls",
              "elapsedMs",
              "generatorMemoryBytes",
              "sutMemoryBytes",
              "diskReserveBytes",
              "cpuPercent",
              "costCeiling",
              "currency"
            ]
          }
        },
        "required": [
          "serviceId",
          "environmentId",
          "origin",
          "addresses",
          "topologyHash",
          "namespaces",
          "ownerIdentity",
          "budgetCeilings"
        ]
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "productionHosts",
    "trustedKeys",
    "targets"
  ]
}
