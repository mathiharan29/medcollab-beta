{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocle:performance:schemas/actor-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "users": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "devicesPerUser": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "maxActors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "users",
    "devicesPerUser",
    "maxActors"
  ]
}
