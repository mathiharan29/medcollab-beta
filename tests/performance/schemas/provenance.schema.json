{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocle:performance:schemas/provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "repository": {
      "const": "mathiharan29/medcollab-beta"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "harnessSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lockfileHashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artillery": {
          "anyOf": [
            {
              "const": "2.0.34"
            },
            {
              "type": "null"
            }
          ]
        },
        "socketIOClient": {
          "anyOf": [
            {
              "const": "4.8.3"
            },
            {
              "type": "null"
            }
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "node",
        "artillery",
        "socketIOClient",
        "os",
        "arch",
        "timezone"
      ]
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "topologyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "indexManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "providerConfigHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instrumentationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "capturedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "repository",
    "sourceSha",
    "harnessSha",
    "configHash",
    "lockfileHashes",
    "runtime",
    "environmentId",
    "topologyHash",
    "dataManifestHash",
    "indexManifestHash",
    "providerConfigHash",
    "instrumentationHash",
    "executionIdentity",
    "capturedAt",
    "digest"
  ]
}
