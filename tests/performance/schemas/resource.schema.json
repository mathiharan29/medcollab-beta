{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocle:performance:schemas/resource.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "account",
        "space",
        "channel",
        "message",
        "handoff",
        "notification",
        "media",
        "file",
        "database",
        "volume",
        "network",
        "process",
        "fault"
      ]
    },
    "id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^*?\\r\\n]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ownerIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "leaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "intentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  },
  "required": [
    "type",
    "id",
    "namespace",
    "ownerIdentity",
    "runId",
    "environmentId",
    "leaseId",
    "path",
    "intentId"
  ]
}
