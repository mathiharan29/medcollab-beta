{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocle:performance:schemas/run-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "authorizationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "repository": {
      "const": "mathiharan29/medcollab-beta"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "harnessSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 45,
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "required": [
          "caseId",
          "id"
        ]
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "topologyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "class",
        "id",
        "topologyHash"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "redirects": {
          "const": false
        }
      },
      "required": [
        "serviceId",
        "url",
        "addresses",
        "redirects"
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "B",
            "C",
            "L",
            "T",
            "P",
            "Z",
            "G",
            "F"
          ]
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "distributionVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "syntheticAccounts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "profile",
        "seed",
        "distributionVersion",
        "syntheticAccounts"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "indexManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "datasetVersion",
        "manifestHash",
        "indexManifestHash",
        "seed"
      ]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "msg91": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "double",
                "networked-simulator",
                "sandbox"
              ]
            },
            "budget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "egress": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "budget",
            "egress"
          ]
        },
        "fcm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "double",
                "networked-simulator",
                "sandbox"
              ]
            },
            "budget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "egress": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "budget",
            "egress"
          ]
        },
        "cloudinary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "double",
                "networked-simulator",
                "sandbox"
              ]
            },
            "budget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "egress": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "budget",
            "egress"
          ]
        }
      },
      "required": [
        "msg91",
        "fcm",
        "cloudinary"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistentConnections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "newConnectionsPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "httpStartsPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "messageStartsPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventStartsPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outboundDeliveries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrentUploads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxUploadBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytesTransferred": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalMessages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "databaseGrowthBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providerCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "generatorMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sutMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "diskReserveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cpuPercent": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "costCeiling": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "USD"
        }
      },
      "required": [
        "persistentConnections",
        "newConnectionsPerSecond",
        "httpStartsPerSecond",
        "messageStartsPerSecond",
        "eventStartsPerSecond",
        "outboundDeliveries",
        "concurrentUploads",
        "maxUploadBytes",
        "bytesTransferred",
        "totalRequests",
        "totalMessages",
        "totalEvents",
        "databaseGrowthBytes",
        "providerCalls",
        "elapsedMs",
        "generatorMemoryBytes",
        "sutMemoryBytes",
        "diskReserveBytes",
        "cpuPercent",
        "costCeiling",
        "currency"
      ]
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setupMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "operationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "observationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "drainMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "cleanupMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "totalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      },
      "required": [
        "setupMs",
        "operationMs",
        "observationMs",
        "drainMs",
        "cleanupMs",
        "totalMs"
      ]
    },
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "external",
            "diagnostic-preload",
            "application",
            "device"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "overheadEvidence": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "version",
        "overheadEvidence"
      ]
    },
    "limiter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeEnv": {
          "enum": [
            "production",
            "test",
            "development"
          ]
        },
        "settingsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurementMode": {
          "enum": [
            "deployment-policy",
            "controlled-ceiling"
          ]
        }
      },
      "required": [
        "nodeEnv",
        "settingsHash",
        "measurementMode"
      ]
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "thresholds": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policyRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "policyRef",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ledgerLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxStages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        }
      },
      "required": [
        "maxActions",
        "maxStages",
        "maxBytes"
      ]
    },
    "journalLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        },
        "cleanupAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "maxEntries",
        "maxBytes",
        "cleanupAttempts"
      ]
    },
    "executionAuthorized": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "authorizationRef",
    "repository",
    "sourceSha",
    "harnessSha",
    "caseIds",
    "variants",
    "environment",
    "target",
    "workload",
    "data",
    "providers",
    "budgets",
    "deadlines",
    "instrumentation",
    "limiter",
    "baseline",
    "thresholds",
    "ledgerLimits",
    "journalLimits",
    "executionAuthorized"
  ]
}
