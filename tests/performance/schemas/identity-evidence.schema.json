{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocle:performance:schemas/identity-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "authorizationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "harnessSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "configHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "topologyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resolvedAddresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "ownerIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "create",
              "observe",
              "cleanup"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "egressBlocked": {
          "const": true
        },
        "credentialsIsolated": {
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "keyId",
        "runId",
        "authorizationRef",
        "sourceSha",
        "harnessSha",
        "configHash",
        "serviceId",
        "environmentId",
        "topologyHash",
        "origin",
        "resolvedAddresses",
        "leaseId",
        "ownerIdentity",
        "namespaces",
        "issuedAt",
        "expiresAt",
        "permissions",
        "egressBlocked",
        "credentialsIsolated"
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "payload",
    "signature"
  ]
}
